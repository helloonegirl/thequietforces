---
import Base from '../layouts/Base.astro';
import PhaseOneShell from '../components/PhaseOneShell.astro';
import { getProduct } from '../data/catalog';
const p = getProduct('volume-three');
---
<Base title={`${p.volumeLabel} · ${p.title}`} description={p.metaDescription}>
  <PhaseOneShell
    pageLabel={`${p.volumeLabel} · ${p.theme}`}
    headline="The Quiet Forces."
    blurb={p.longDescription}
  />
</Base>
