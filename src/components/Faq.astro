---
import type { FaqItem } from '../data/catalog';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq-list">
  {items.map((item, i) => (
    <details class="faq-item" open={i === 0}>
      <summary class="faq-q">
        <span>{item.q}</span>
        <span class="faq-toggle" aria-hidden="true">+</span>
      </summary>
      <div class="faq-a">{item.a}</div>
    </details>
  ))}
</div>

<style>
  .faq-list { max-width: 760px; margin: 0 auto; }
  .faq-item {
    border-bottom: 1px solid var(--border);
    padding: 0;
  }
  .faq-q {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 24px 0;
    font-family: 'Fraunces', serif;
    font-size: 19px;
    font-weight: 500;
    color: var(--text);
    line-height: 1.3;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-toggle {
    font-family: 'Fraunces', serif;
    font-size: 22px;
    color: var(--gold-dark);
    transition: transform 200ms ease;
    flex-shrink: 0;
  }
  .faq-item[open] .faq-toggle { transform: rotate(45deg); }
  .faq-a {
    color: var(--text-mid);
    font-size: 16px;
    line-height: 1.65;
    padding: 0 0 28px;
    max-width: 640px;
  }
</style>
