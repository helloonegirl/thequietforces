---
import { site } from '../data/catalog';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-col">
      <div class="font-serif text-xl tracking-tightish text-ink">{site.brandName}</div>
      <p class="footer-tag">A working notebook on the forces that shape a life.</p>
    </div>

    <div class="footer-col">
      <p class="eyebrow">Read</p>
      <ul>
        <li><a href={`${base}/volume-one`}>Volume I · Being</a></li>
        <li><a href={`${base}/volume-two`}>Volume II · Deciding</a></li>
        <li><a href={`${base}/volume-three`}>Volume III · Relating</a></li>
        <li><a href={`${base}/the-quiet-work`}>The Quiet Work · Doing</a></li>
        <li><a href={`${base}/bundles`}>Bundles</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <p class="eyebrow">More</p>
      <ul>
        <li><a href={`${base}/about`}>About</a></li>
        <li><a href={`${base}/journal`}>Journal</a></li>
        <li><a href={`${base}/starter-guide`}>Free starter guide</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-fine">
    <span>© {year} {site.brandName}.</span>
    <span>All rights reserved.</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--cream);
    padding: 72px 32px 40px;
    margin-top: 120px;
  }
  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 56px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--border);
  }
  .footer-col ul { list-style: none; padding: 0; margin: 14px 0 0; }
  .footer-col li { margin-bottom: 8px; }
  .footer-col a {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: var(--text-mid);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .footer-col a:hover { color: var(--gold-dark); }
  .footer-tag {
    font-family: 'Fraunces', serif;
    font-style: italic;
    color: var(--text-mid);
    margin-top: 12px;
    max-width: 320px;
    line-height: 1.5;
    font-size: 15px;
  }
  .footer-fine {
    max-width: 1200px;
    margin: 24px auto 0;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    color: var(--text-dim);
    font-size: 12px;
    letter-spacing: 0.05em;
  }
  @media (max-width: 760px) {
    .footer-inner { grid-template-columns: 1fr; gap: 36px; padding-bottom: 32px; }
    .site-footer { padding: 56px 20px 32px; margin-top: 80px; }
  }
</style>
