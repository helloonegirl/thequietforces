---
// Temporary "under construction" shell used while Phase 2-4 are built out.
// Real page contents replace this in later phases.

interface Props {
  pageLabel: string;       // "Homepage", "Volume I", etc.
  headline: string;        // shown in Fraunces, large
  blurb: string;           // shown in Fraunces italic, mid-text, smaller
}

const { pageLabel, headline, blurb } = Astro.props;
---
<main class="min-h-screen flex items-center justify-center px-6 py-24 paper-grain">
  <div class="relative z-10 max-w-2xl text-left">
    <p class="eyebrow mb-8">{pageLabel} · In Construction</p>
    <h1 class="font-serif text-5xl md:text-6xl leading-[1.05] tracking-tighter2 mb-8 text-ink">
      {headline}
    </h1>
    <p class="font-serif italic text-xl leading-relaxed text-ink-mid mb-10 max-w-prose2">
      {blurb}
    </p>
    <div class="h-px w-16 bg-gold-dark mb-10"></div>
    <p class="text-sm text-ink-dim">
      The new site is being built in phases. The real design lands here in Phase 2.
    </p>
  </div>
</main>
